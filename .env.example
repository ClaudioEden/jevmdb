# Copie para .env e preencha. O .env fica fora do git.
TYPESAFE_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=
GEMINI_API_KEY=

# Trava da consulta grátis (1 = ligada, 0 = desligada). O que for passado na linha de comando vale mais que isto.
JEV_COTA_ANONIMA=1
# Buscas grátis por visitante (lista ou texto)
JEV_COTA_GRATIS=5
# Buscas por IP em 24 h, de todos juntos
JEV_COTA_LIMITE_IP=30
# Seu WhatsApp (DDI + DDD + número, só dígitos): botão "Pedir mais buscas"
JEV_WHATSAPP=
# Senha do console em /admin (sem ela o console fica desligado)
JEV_ADMIN_SENHA=
# Teto de gasto por dia, em US$ (Jev + Gemini). 0 desliga
JEV_TETO_DIARIO_USD=2
