# Copie para .env e preencha. O .env fica fora do git.
TYPESAFE_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=
GEMINI_API_KEY=

# Trava da consulta grátis (1 = ligada, 0 = desligada). O que for passado na linha de comando vale mais que isto.
JEV_COTA_ANONIMA=1
# Teto de consultas grátis por IP em 24 h (o fingerprint e o cookie barram já na 2ª do mesmo navegador)
JEV_COTA_LIMITE_IP=5
